# Copy to `.env` (development) — never commit real values.
# Use separate Supabase projects for development, preview/staging and production.

# development | preview | production  (controls app name / bundle id, see app.config.ts)
APP_VARIANT=development

# --- Client-safe values (inlined into the JS bundle) -------------------------
# Supabase project URL and the public anon / publishable key.
# Leave empty to run the app in local-only mode (no account, no sync).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, used if the publishable key is empty:
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_MEDIA_BUCKET=user-media

# EAS project id (from `eas init`), optional for local development.
EAS_PROJECT_ID=

# --- Server-side only --------------------------------------------------------
# NEVER prefix these with EXPO_PUBLIC_ and never put them in the app.
# Set them as Supabase Edge Function secrets:
#   supabase secrets set OPENAI_API_KEY=...
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY is provided automatically to Edge Functions.

# --- Tests -------------------------------------------------------------------
# PostgreSQL used by `npm run test:db` (a throwaway database is created per run).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
