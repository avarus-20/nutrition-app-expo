# Edge Function secrets. Server-side only: never prefix with EXPO_PUBLIC_ and
# never commit real values. Local: `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set --env-file supabase/functions/.env` (per project/environment).
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# OpenAI-compatible provider for photo estimates and speech-to-text.
# Without AI_API_KEY the functions answer 503 {"error":"not_configured"} and the
# app falls back to manual entry / typed text.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini
AI_STT_MODEL=whisper-1

# Per-user hourly quotas (table public.ai_usage, migration 20261007000004).
AI_PHOTO_LIMIT_PER_HOUR=30
AI_STT_LIMIT_PER_HOUR=60

# Storage bucket used by delete-account (must match the migration).
MEDIA_BUCKET=user-media
